{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "comfy-ui-api-workflow": ["./src/index.ts"],
      "comfy-ui-api-workflow/nodes": ["./src/nodes.ts"],
      "comfy-ui-api-workflow/nodes/*": ["./src/nodes/*.ts"],
      "comfy-ui-api-workflow/errors": ["./src/errors.ts"],
      "comfy-ui-api-workflow/errors/*": ["./src/errors/*.ts"],
      "comfy-ui-api-workflow/exceptions": ["./src/exceptions.ts"],
      "comfy-ui-api-workflow/enums": ["./src/enums.ts"]
    }
  },
  "include": ["src", "tests", "scripts", "examples", "vitest.config.ts"]
}
